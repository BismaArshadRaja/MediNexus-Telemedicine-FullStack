# Get a FREE API key from https://console.groq.com  (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# JWT secret - change this to any random long string
JWT_SECRET_KEY=change_this_to_a_long_random_secret_string

# Token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite database (free, file-based, no setup needed)
DATABASE_URL=sqlite:///./telemedicine.db

# CORS - your frontend URL
FRONTEND_URL=http://localhost:5173
